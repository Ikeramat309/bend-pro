{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bendpro.local/research/benders/schema/models.json",
  "title": "Bender models staging file",
  "type": "object",
  "required": ["schemaVersion", "retrievedDate", "models"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "retrievedDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "manufacturerId",
          "brand",
          "family",
          "series",
          "modelNumbers",
          "skus",
          "aliases",
          "category",
          "driveType",
          "material",
          "marketStatus",
          "regions",
          "supportedConduitTypes",
          "supportedNominalSizes",
          "sourceIds",
          "notes",
          "researchClass"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.json#/$defs/id" },
          "manufacturerId": { "$ref": "common.json#/$defs/id" },
          "brand": { "$ref": "common.json#/$defs/nonEmptyString" },
          "family": { "type": "string" },
          "series": { "type": "string" },
          "modelNumbers": {
            "type": "array",
            "items": { "type": "string" }
          },
          "skus": {
            "type": "array",
            "items": { "type": "string" }
          },
          "aliases": {
            "type": "array",
            "items": { "type": "string" }
          },
          "category": { "$ref": "common.json#/$defs/category" },
          "driveType": { "$ref": "common.json#/$defs/driveType" },
          "material": {
            "anyOf": [{ "type": "null" }, { "type": "string" }]
          },
          "marketStatus": { "$ref": "common.json#/$defs/marketStatus" },
          "introducedDate": {
            "anyOf": [{ "type": "null" }, { "type": "string" }]
          },
          "discontinuedDate": {
            "anyOf": [{ "type": "null" }, { "type": "string" }]
          },
          "replacementModelIds": {
            "type": "array",
            "items": { "$ref": "common.json#/$defs/id" }
          },
          "regions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "supportedConduitTypes": {
            "type": "array",
            "items": { "$ref": "common.json#/$defs/conduitType" }
          },
          "supportedNominalSizes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "sourceIds": {
            "type": "array",
            "items": { "$ref": "common.json#/$defs/id" }
          },
          "notes": { "type": "string" },
          "researchClass": {
            "type": "string",
            "enum": [
              "identity_verified",
              "chart_candidate",
              "reference_only",
              "conflict_review",
              "blocked_source",
              "rejected"
            ]
          },
          "parentFrameModelId": {
            "anyOf": [
              { "type": "null" },
              { "$ref": "common.json#/$defs/id" }
            ]
          },
          "operationMode": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "string",
                "enum": [
                  "one_shot",
                  "segmented",
                  "multi_shot",
                  "hand_continuous",
                  "unknown",
                  "n/a"
                ]
              }
            ]
          }
        }
      }
    }
  }
}
